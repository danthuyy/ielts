{
  "id": "gram_02",
  "title": "Danh từ số ít và số nhiều",
  "order": 2,
  "summary": "Học cách thêm s hoặc es khi có nhiều hơn một vật, và vài từ đổi khác hẳn.",
  "points": [
    {
      "rule": "Một vật thì để nguyên, nhiều vật thì thêm -s",
      "vi": "Tiếng Việt không đổi từ khi có nhiều vật, nhưng tiếng Anh phải thêm \"s\".",
      "examples": [
        { "en": "I have one book.", "vi": "Tôi có một quyển sách." },
        { "en": "I have two books.", "vi": "Tôi có hai quyển sách." },
        { "en": "The dogs are here.", "vi": "Mấy con chó ở đây." }
      ]
    },
    {
      "rule": "Thêm -es sau s, x, ch, sh, o",
      "vi": "Những từ tận cùng bằng s, x, ch, sh, o thì thêm \"es\" cho dễ đọc.",
      "examples": [
        { "en": "I eat two boxes.", "vi": "Tôi ăn hai hộp." },
        { "en": "We have three watches.", "vi": "Chúng tôi có ba cái đồng hồ." },
        { "en": "She likes red tomatoes.", "vi": "Cô ấy thích cà chua đỏ." }
      ]
    },
    {
      "rule": "Từ tận cùng phụ âm + y đổi thành -ies",
      "vi": "Bỏ chữ \"y\" rồi thêm \"ies\". Ví dụ baby thành babies.",
      "examples": [
        { "en": "I see two babies.", "vi": "Tôi thấy hai em bé." },
        { "en": "We have five cities.", "vi": "Chúng tôi có năm thành phố." },
        { "en": "She buys many candies.", "vi": "Cô ấy mua nhiều kẹo." }
      ]
    },
    {
      "rule": "Vài từ đổi khác hẳn, phải học thuộc",
      "vi": "Một số từ không thêm s mà đổi hẳn: man thành men, child thành children.",
      "examples": [
        { "en": "Two men are here.", "vi": "Hai người đàn ông ở đây." },
        { "en": "The children are happy.", "vi": "Bọn trẻ vui vẻ." },
        { "en": "I have two feet.", "vi": "Tôi có hai bàn chân." }
      ]
    }
  ],
