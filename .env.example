# Optional. Without these the app falls back to the values in src/lib/config.ts.
# The anon key is Supabase's publishable key and is safe to ship in the bundle;
# never put a service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
VITE_SUPABASE_TABLE=sync_state
VITE_SYNC_ROW_ID=00000000-0000-0000-0000-000000000000
